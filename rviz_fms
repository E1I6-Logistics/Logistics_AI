#!/usr/bin/env bash
# PC 로컬 맵 서버 + 첨부 RViz 설정을 함께 실행한다.
set -eo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROS_SETUP="${FMS_ROS_SETUP:-/opt/ros/jazzy/setup.bash}"
if [[ ! -f "$ROS_SETUP" ]]; then
    echo "[RVIZ][오류] ROS 2 환경 파일을 찾을 수 없습니다: $ROS_SETUP" >&2
    exit 1
fi
source "$ROS_SETUP"
ROS_WS_SETUP="${FMS_ROS_WS_SETUP:-$PROJECT_DIR/robots_ws/Logistics_AMR/install/setup.bash}"
if [[ -f "$ROS_WS_SETUP" ]]; then source "$ROS_WS_SETUP"; fi
export ROS_DOMAIN_ID="${FMS_ROS_DOMAIN_ID:-${ROS_DOMAIN_ID:-15}}"
export RMW_IMPLEMENTATION="${FMS_RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"
export ROS_AUTOMATIC_DISCOVERY_RANGE="${FMS_ROS_AUTOMATIC_DISCOVERY_RANGE:-LOCALHOST}"
unset ROS_LOCALHOST_ONLY
printf '[RVIZ] PC 저장 맵 사용 · /fms_view/map · ROS_DOMAIN_ID=%s\n' "$ROS_DOMAIN_ID"
printf '[RVIZ] 맵은 로봇 연결 없이 표시됩니다. 로봇 위치·경로는 연결된 경우 표시됩니다.\n'
exec ros2 launch "$PROJECT_DIR/scripts/rviz/local_map.launch.py" "$@"
