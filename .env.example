# Shared FMS and AI settings

FMS_ROBOT_MODE=simulation

FMS_MAP_YAML=logitle_map.yaml

FMS_ROUTE_GRAPH=test.geojson

FMS_CORS_ORIGINS=*

# Copy this file to .env and fill in private keys there.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:1b
# LLM 입력은 원본 test.geojson 또는 축약된 test_compact_graph.geojson 중 선택한다.
LLM_ROUTE_GRAPH=test_compact_graph.geojson
# 실패 시 최대 요청 횟수. 유료 API 사용 시 비용 증가에 주의한다.
LLM_MAX_ATTEMPTS=1
# provider HTTP 요청 제한 시간(초)
LLM_TIMEOUT_SECONDS=60
# 전체 경로 판단의 실시간 목표 시간(초)
PATH_DECISION_DEADLINE_SECONDS=0.15
# OLLAMA_HOST=http://localhost:11434

OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Anthropic을 사용할 때 LLM_PROVIDER=anthropic으로 변경하고 아래 값을 채운다.
# Structured Outputs를 지원하는 Claude 모델 ID를 사용한다.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Jetson에서는 Hugging Face Laya를 CUDA로 직접 실행한다.
ROUTE_SELECTOR=laya
LAYA_HF_MODEL=convaiinnovations/laya-multilingual
LAYA_DEVICE=cuda:0
LAYA_REQUIRE_CUDA=true
# Jetson에서 사용 가능한 약 4.5GB RAM을 고려한 입력 토큰 상한
LAYA_MAX_LENGTH=4096
# AllRoutes 시험처럼 선택지가 많을 때만 전체/선택지 토큰 예산을 함께 늘린다.
# LAYA_MAX_LENGTH=8192
# LAYA_HEAD_MAX_LENGTH=2048
# 선택 사항: Hugging Face 캐시 위치와 비공개 모델 토큰
# HF_HOME=/home/sein/.cache/huggingface
# HF_TOKEN=

# Kev 공식 runtime 서버를 사용할 때 ROUTE_SELECTOR=kev로 변경한다.
# Kev 서버는 한 번에 하나만 실행하며 두 모델 모두 8011 포트를 사용한다.
# Jetson/PC 경량: python -m kev.serve --run jaredpalmer/kev-0.8b@v1.0 --port 8011
# PC 고성능: python -m kev.serve --run jaredpalmer/kev-4b@v1.0 --port 8011
# 실행한 checkpoint에 맞춰 KEV_MODEL을 kev-08b 또는 kev-4b로 지정한다.
# ROUTE_SELECTOR=kev
KEV_HOST=http://127.0.0.1:8011
KEV_MODEL=kev-08b
KEV_REQUIRE_CUDA=true
KEV_TIMEOUT_SECONDS=60
# KEV_API_KEY=
# 주문 배차용 KEV 호출 timeout(초)과 실패 후 KEV를 건너뛰는 시간(초)
KEV_DISPATCH_TIMEOUT_SECONDS=3
KEV_DISPATCH_COOLDOWN_SECONDS=30
# 최단 픽업 ETA와 이 값(초) 이내인 후보만 KEV가 비교합니다. 현재 코드와 KEV 비교 실험의 값은 2초이며,
# 실제 로봇 ETA 측정과 실험 결과를 확인한 뒤 운영 정책값으로 재검토합니다.
KEV_DISPATCH_ETA_TIE_SECONDS=2
# ETA 계산 속도(m/s)입니다. 시뮬레이션 기본값은 0.2이며, 실제 로봇은 실측 평균 속도로 변경해야 합니다.
KEV_DISPATCH_ETA_SPEED_MPS=0.2

# 0이면 주문 없이 마커 노드로 보냈을 때 ArUco 정렬을 하지 않는다 (Nav2 도착 오차 측정용, 기본 1)
# FMS_REAL_ARUCO_AUTO_ALIGN=1

# 배차 후보로 허용하는 최소 배터리 전압(V). 실측 전 임시 기준 11.2V이며, 전압을 모르는 로봇도 제외한다. 0이면 검사하지 않는다.
# FMS_MIN_DISPATCH_BATTERY_VOLTAGE=11.2
# 실제 모드에서 Zenoh 연결 목록을 백엔드가 확인하는 주기(초). 프론트엔드 화면을 열지 않아도 연결 상태를 갱신한다.
# FMS_ZENOH_CONNECTION_SYNC_INTERVAL_S=2
# 실제 로봇은 최근 이 시간(초) 동안 받은 전압 중 최저값으로 판단한다. 직전 주행의 전압 강하를 반영하기 위한 값이다.
# FMS_BATTERY_VOLTAGE_WINDOW_S=60
# 시뮬레이션 전압(V) 초기값. 기본은 모두 12.0V. 예: robot1만 하한 미만으로 만들 때
# SIM_BATTERY_VOLTAGE_OVERRIDE=robot1=11.0
